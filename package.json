{
	"name": "@arsdehnel/rwsdk-atp",
	"version": "1.0.1",
	"description": "Utilities for making a RedwoodSDK app work nicely on the AT Protocol",
	"keywords": [],
	"license": "ISC",
	"author": "",
	"sideEffects": false,
	"type": "module",
	"exports": {
		"./auth": {
			"import": "./dist/auth.js",
			"types": "./dist/auth.d.ts"
		},
		"./browser-sessions": {
			"import": "./dist/browser-sessions.js",
			"types": "./dist/browser-sessions.d.ts"
		},
		"./errors": {
			"import": "./dist/errors.js",
			"types": "./dist/errors.d.ts"
		},
		"./logger": {
			"import": "./dist/logger.js",
			"types": "./dist/logger.d.ts"
		},
		"./middleware": {
			"import": "./dist/middleware.js",
			"types": "./dist/middleware.d.ts"
		},
		"./oauth": {
			"import": "./dist/oauth.js",
			"types": "./dist/oauth.d.ts"
		},
		"./response": {
			"import": "./dist/response.js",
			"types": "./dist/response.d.ts"
		},
		"./tap": {
			"import": "./dist/tap.js",
			"types": "./dist/tap.d.ts"
		},
		"./utils": {
			"import": "./dist/utils.js",
			"types": "./dist/utils.d.ts"
		},
		"./vite": {
			"import": "./dist/vite.js",
			"types": "./dist/vite.d.ts"
		},
		"./worker-error": {
			"import": "./dist/worker-error.js",
			"types": "./dist/worker-error.d.ts"
		}
	},
	"main": "src/index.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"biome:check": "biome check",
		"biome:fix": "biome check --write .",
		"build": "tsup",
		"ci:lint": "pnpm types:check && pnpm biome:check && pnpm knip:check && pnpm prettier:check",
		"ci:tests": "pnpm test:run && pnpm build",
		"dev": "tsup --watch",
		"docs:build": "typedoc && vitepress build docs",
		"docs:dev": "typedoc && vitepress dev docs",
		"knip:check": "knip",
		"knip:fix": "knip --fix",
		"prepare": "husky || true && tsup",
		"prettier:check": "prettier --check .",
		"prettier:fix": "prettier --write .",
		"test:run": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@atproto/lex": "^0.4.4",
		"@atproto/lex-password-session": "^0.3.5",
		"@atproto/oauth-client-node": "^0.5.13",
		"@atproto/tap": "^0.4.17",
		"chalk": "^6.0.1",
		"chalk-template": "^1.1.3",
		"cookie": "^2.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@cloudflare/workers-types": "^5.20260924.1",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^20.4.1",
		"@types/node": "^26.6.2",
		"@types/react": "^19",
		"@vitest/coverage-v8": "^5.1.0",
		"husky": "^9.1.7",
		"knip": "^6.32.2",
		"lint-staged": "^17.5.1",
		"prettier": "^3.8.1",
		"prettier-plugin-packagejson": "^3.0.2",
		"tsup": "^8.3.0",
		"typedoc": "^0.28.0",
		"typedoc-plugin-markdown": "^4.0.0",
		"typescript": "^5.5.0",
		"vitepress": "^1.0.0",
		"vitest": "^5.1.0"
	},
	"peerDependencies": {
		"react": "^19",
		"rwsdk": "1.7.5",
		"vite": "8.3.8"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.16.1",
			"onFail": "warn"
		}
	},
	"publishConfig": {
		"access": "restricted",
		"registry": "https://npm.pkg.github.com"
	}
}
