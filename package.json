{
	"name": "rwsdk-atp",
	"version": "0.0.1",
	"private": true,
	"description": "Utilities for making a RedwoodSDK app work nicely on the AT Protocol",
	"keywords": [],
	"license": "ISC",
	"author": "",
	"sideEffects": false,
	"type": "module",
	"exports": {
		"./browser-sessions": {
			"import": "./dist/browser-sessions.js",
			"types": "./dist/browser-sessions.d.ts"
		},
		"./logger": {
			"import": "./dist/logger.js",
			"types": "./dist/logger.d.ts"
		},
		"./oauth": {
			"import": "./dist/oauth.js",
			"types": "./dist/oauth.d.ts"
		},
		"./tap": {
			"import": "./dist/tap.js",
			"types": "./dist/tap.d.ts"
		},
		"./vite": {
			"import": "./dist/vite.js",
			"types": "./dist/vite.d.ts"
		}
	},
	"main": "src/index.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"biome:check": "biome check",
		"biome:fix": "biome check --write .",
		"build": "tsup",
		"ci:lint": "pnpm types:check && pnpm biome:check && pnpm knip:check && pnpm prettier:check",
		"ci:tests": "pnpm build",
		"dev": "tsup --watch",
		"knip:check": "knip",
		"knip:fix": "knip --fix",
		"prepare": "husky || true && tsup",
		"prettier:check": "prettier --check .",
		"prettier:fix": "prettier --write .",
		"test:run": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@atproto/lex": "^0.4.4",
		"@atproto/oauth-client-node": "^0.5.13",
		"@atproto/tap": "^0.4.17",
		"chalk": "^6.0.1",
		"chalk-template": "^1.1.3",
		"cookie": "^2.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@cloudflare/workers-types": "^5.20260924.1",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^20.4.1",
		"@types/node": "^26.6.2",
		"husky": "^9.1.7",
		"knip": "^6.32.2",
		"lint-staged": "^17.5.1",
		"prettier": "^3.8.1",
		"prettier-plugin-packagejson": "^3.0.2",
		"tsup": "^8.3.0",
		"typescript": "^5.5.0",
		"vitest": "^5.0.1"
	},
	"peerDependencies": {
		"rwsdk": "1.7.5",
		"vite": "8.3.5"
	},
	"packageManager": "pnpm@12.16.1",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.16.1",
			"onFail": "download"
		}
	},
	"publishConfig": {
		"access": "restricted"
	}
}
